+void TransformerServingLayer::clearLiveSlot_(unsigned int slot)
+{
+	if (slot < live_.size())
+	{
+		live_[slot].id = 0ULL;
+		live_[slot].cb = CallbackHandle();
+	}
+	if (slot < slotCancel_.size())
+		slotCancel_[slot] = 0u;
