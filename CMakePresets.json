{
    "version": 6,
    "configurePresets": [
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INSTALL_PREFIX": "$env{HOME}/.local",
                "CMAKE_PREFIX_PATH": "$env{HOME}/.local",
                "DEV_MODE": "OFF",
                "GLADES_ENABLE_CUDA": "OFF"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-cuda",
            "displayName": "Linux Release + CUDA",
            "inherits": "linux-release",
            "cacheVariables": {
                "GLADES_ENABLE_CUDA": "ON"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release (MSVC)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_INSTALL_PREFIX": "C:/GatticSDK",
                "CMAKE_PREFIX_PATH": "C:/GatticSDK",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
                "DEV_MODE": "OFF",
                "GLADES_ENABLE_CUDA": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-cuda",
            "displayName": "Windows Release + CUDA (MSVC)",
            "inherits": "windows-release",
            "cacheVariables": {
                "GLADES_ENABLE_CUDA": "ON"
            }
        },
        {
            "name": "windows-dev",
            "displayName": "Windows Dev (MSVC, local shmea headers)",
            "inherits": "windows-release",
            "cacheVariables": {
                "DEV_MODE": "ON",
                "CMAKE_PREFIX_PATH": "$env{USERPROFILE}/dev/installed",
                "CMAKE_INSTALL_PREFIX": "$env{USERPROFILE}/dev/installed"
            }
        },
        {
            "name": "windows-dev-cuda",
            "displayName": "Windows Dev + CUDA (MSVC, local shmea headers)",
            "inherits": "windows-dev",
            "cacheVariables": {
                "GLADES_ENABLE_CUDA": "ON"
            }
        },
        {
            "name": "linux-dev",
            "inherits": "linux-release",
            "cacheVariables": {
                "DEV_MODE": "ON"
            }
        },
        {
            "name": "linux-dev-cuda",
            "inherits": "linux-dev",
            "cacheVariables": {
                "GLADES_ENABLE_CUDA": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-cuda",
            "configurePreset": "linux-cuda"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "windows-cuda",
            "configurePreset": "windows-cuda"
        },
        {
            "name": "windows-dev",
            "configurePreset": "windows-dev"
        },
        {
            "name": "windows-dev-cuda",
            "configurePreset": "windows-dev-cuda"
        },
        {
            "name": "linux-dev",
            "configurePreset": "linux-dev"
        },
        {
            "name": "linux-dev-cuda",
            "configurePreset": "linux-dev-cuda"
        }
    ]
}
